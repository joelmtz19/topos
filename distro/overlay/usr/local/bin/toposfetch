#!/usr/bin/python3
"""toposfetch: el sistema y tu mundo de un vistazo / your system and world at a glance.

El dibujo es un complejo de verdad: tres triángulos rellenos alrededor de uno
vacío. Su homología es β₀ = 1, β₁ = 1: el hueco del centro.
The logo is a real complex: three filled triangles around an empty one, so
β₀ = 1, β₁ = 1 — the hole in the middle.
"""

import os
import platform

from topos.i18n import t

C, M, D, B, R = "\033[1;36m", "\033[38;5;141m", "\033[2m", "\033[1m", "\033[0m"

ART = [
    f"        {C}●{R}        ",
    f"       {C}╱{M}▓{C}╲{R}       ",
    f"      {C}╱{M}▓▓▓{C}╲{R}      ",
    f"     {C}●─────●{R}     ",
    f"    {C}╱{M}▓{C}╲{R}   {C}╱{M}▓{C}╲{R}    ",
    f"   {C}╱{M}▓▓▓{C}╲{R} {C}╱{M}▓▓▓{C}╲{R}   ",
    f"  {C}●─────●─────●{R}  ",
    f"                 ",
    f" {D}β₀ = 1  β₁ = 1{R} ",
]


def read(path, default=""):
    try:
        with open(path, encoding="utf-8") as f:
            return f.read().strip()
    except OSError:
        return default


def os_name():
    for line in read("/etc/os-release").splitlines():
        if line.startswith("PRETTY_NAME="):
            name = line.split("=", 1)[1].strip('"')
            debian = read("/etc/debian_version")
            return t(f"{name} (sobre Debian {debian})", f"{name} (on Debian {debian})") if debian else name
    return platform.system()


def uptime():
    secs = int(float(read("/proc/uptime", "0").split()[0]))
    h, m = divmod(secs // 60, 60)
    return f"{h} h {m} min" if h else f"{m} min"


def memory():
    info = {}
    for line in read("/proc/meminfo").splitlines():
        k, _, v = line.partition(":")
        info[k] = int(v.split()[0]) if v.split() else 0
    total, avail = info.get("MemTotal", 0), info.get("MemAvailable", 0)
    return f"{(total - avail) // 1024} MiB / {total // 1024} MiB"


def world():
    try:
        from topos.store import Store
        s = Store.find()
    except Exception:
        return [t("sin mundo (corre `topos init`)", "no world (run `topos init`)")], []
    h = s.homology(1)
    sheaf = s.sheaf()
    obst = len(sheaf.conflicts)
    lines = [t(f"{len(s.vertices)} archivos, {len(s.relations)} relaciones",
               f"{len(s.vertices)} files, {len(s.relations)} relations"),
             f"β = ({', '.join(map(str, h.betti))})   χ = {h.euler}"]
    if not sheaf.users:
        extra = t("sin permisos declarados", "no permissions declared")
    elif obst:
        extra = t(f"{obst} obstrucción(es) en H¹", f"{obst} obstruction(s) in H¹")
    else:
        extra = t("sin obstrucciones", "no obstructions")
    return lines, [extra]


def sched():
    try:
        from topos.sched import DEFAULT_SOCKET, Client
        c = Client(DEFAULT_SOCKET)
        n = len(c.call(op="status")["procs"])
        c.close()
        return t(f"activo, {n} proceso(s) coordinados", f"running, {n} process(es) coordinated")
    except Exception:
        return t("apagado (topos sched serve)", "off (topos sched serve)")


def label(es, en):
    return f"{M}{t(es, en):<10}{R}"


def main():
    import pwd
    user = pwd.getpwuid(os.getuid()).pw_name
    mw, perm = world()
    mount = os.path.expanduser("~/mundo")
    info = [
        f"{B}{C}{user}{R}{B}@topOS{R}",
        f"{D}{'─' * 30}{R}",
        f"{label('Sistema', 'System')}{os_name()}",
        f"{label('Kernel', 'Kernel')}{platform.release()}",
        f"{label('Encendido', 'Uptime')}{uptime()}",
        f"{label('Memoria', 'Memory')}{memory()}",
        f"{label('Mundo', 'World')}{mw[0]}",
        *(f"{' ' * 10}{x}" for x in mw[1:]),
        f"{label('Haz', 'Sheaf')}{perm[0] if perm else '—'}",
        f"{label('Montaje', 'Mount')}{'~/mundo' if os.path.ismount(mount) else t('sin montar', 'not mounted')}",
        f"{label('Planif.', 'Scheduler')}{sched()}",
    ]
    rows = max(len(ART), len(info))
    print()
    for i in range(rows):
        left = ART[i] if i < len(ART) else " " * 17
        print(f"  {left}  {info[i] if i < len(info) else ''}")
    example = t("filosofos.txt", "philosophers.txt")
    print(f"\n  {D}{t('prueba', 'try')}:{R} cd ~/mundo · cat holes · topos run "
          f"/usr/share/topos/ejemplos/{example} · topos --help\n")


if __name__ == "__main__":
    main()
